# Copy to .env for local development.
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://whalescale:whalescale@localhost:5432/whalescale
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-only-change-me
# Optional: advertise a relay (Phase 3) to agents as host:port
# RELAY_ADDR=127.0.0.1:3479
# RELAY_REGION_ID=local
# RELAY_REGION_NAME=Local Relay
# Optional: device key lifetime in days (agents auto-rotate before expiry).
# Unset = keys never expire.
# DEVICE_KEY_TTL_DAYS=90
# Used by sqlx-cli / compile-time query checks
SQLX_OFFLINE=true
